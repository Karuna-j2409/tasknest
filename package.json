{
  "name": "tasknest",
  "version": "1.0.0",
  "description": "TaskNest - Student Task Management web app (Node.js + Express + SQLite), containerized with Docker",
  "main": "src/server.js",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22.13"
